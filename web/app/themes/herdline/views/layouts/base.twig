<!DOCTYPE html>
<html {{ site.language_attributes }} class="antialiased scroll-smooth">
    {% block head %}
        {% include 'partials/head.twig' %}
    {% endblock %}

    <body {{ function('body_class', 'bg-white text-gray-900 h-full overflow-x-hidden') }} x-data="animateOnScroll">
        {{ function('wp_body_open') }}
        <a class="skip-link screen-reader-text" href="#content">{{ _e('Skip to content') }}</a>

		{# Fixed Header + persistent article chrome (reading progress + title reveal) #}
		<div x-data="articleChrome" class="fixed top-0 left-0 right-0 z-[1000]">
			<div class="relative bg-gray-900 h-[70px]">
				<div class="container mx-auto h-full flex items-center justify-between gap-3 px-6 lg:px-0">
					<a href="{{ site.url }}" class="shrink-0" aria-label="Homepage">
						<img src="{{ theme.link }}/assets/images/magazine-logo.svg" alt="Marshall Magazine" class="h-10 lg:h-12">
					</a>

					{# Desktop: article title fades in centered once the hero scrolls away.
					   Mobile uses the title strip below instead (the wordmark fills this row).
					   Suppressed when `hide_title_bar` is set (e.g. a cover-led page). #}
					{% if not post.meta('edition_homepage') and not post.meta('hide_title_bar') %}
						<div
							class="hidden md:block absolute left-1/2 -translate-x-1/2 max-w-[46%] px-4 text-center transition-[opacity,transform] duration-500 ease-fluid"
							:class="revealed ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-1 pointer-events-none'"
							aria-hidden="true"
						>
							<span class="block truncate text-white font-science font-bold text-sm uppercase tracking-wide">{{ post.title }}</span>
						</div>
					{% endif %}

					<div class="text-white font-bold text-sm font-science uppercase shrink-0">
						{% if post.meta('edition_homepage') %}
							{{ post.title }}
						{% else %}
							{% if not post.meta('hide_link_back_to_edition') %}
								{% if post.parent %}
									{# Whole row is the link for a larger tap target. #}
									<a href="{{ post.parent.link }}" class="flex space-x-1 items-center hover:underline" aria-label="Back to {{ post.parent.title }}">
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4 lg:mt-0.5 shrink-0">
											<path fill-rule="evenodd" d="M7.72 12.53a.75.75 0 0 1 0-1.06l7.5-7.5a.75.75 0 1 1 1.06 1.06L9.31 12l6.97 6.97a.75.75 0 1 1-1.06 1.06l-7.5-7.5Z" clip-rule="evenodd" />
										</svg>
										<span>{{ post.parent.title }}</span>
									</a>
								{% endif %}
							{% endif %}
						{% endif %}
					</div>
				</div>

				{# Desktop reading-progress bar — pinned to the bottom of the masthead. #}
				{% if not post.meta('hide_reading_status') %}
					<div class="hidden md:block absolute bottom-0 left-0 h-[3px] bg-green-bright" :style="`width: ${progress}%`"></div>
				{% endif %}
			</div>

			{# Mobile: slim title strip drops in below the masthead once the hero scrolls away,
			   with the progress bar along its bottom edge. The mobile progress bar rides in
			   this strip, so `hide_title_bar` removes it too (desktop progress is unaffected). #}
			{% if not post.meta('edition_homepage') and not post.meta('hide_title_bar') %}
				<div
					class="md:hidden bg-gray-900 shadow-lg transition-[opacity,transform] duration-300 ease-fluid"
					:class="revealed ? 'opacity-100 translate-y-0' : 'opacity-0 -translate-y-2 pointer-events-none'"
					aria-hidden="true"
				>
					<div class="relative px-6 py-2">
						<span class="block truncate text-white font-science font-bold text-xs uppercase tracking-wide">{{ post.title }}</span>
						{% if not post.meta('hide_reading_status') %}
							<div class="absolute bottom-0 left-0 h-[3px] bg-green-bright" :style="`width: ${progress}%`"></div>
						{% endif %}
					</div>
				</div>
			{% endif %}
		</div>

		{# Main Content #}
		{% block content %}
			Sorry, no content
		{% endblock %}

		{# Site Footer #}
		{% include 'partials/footer.twig' %}

		{# Analytics Footer Partial #}
		{% include 'partials/analytics/footer.twig' ignore missing %}

		{# GSAP and Alpine.js Scripts #}
		<script>
			gsap.registerPlugin(ScrollTrigger);

			document.querySelectorAll('.photo-slide').forEach((slide) => {
				const idx = +slide.dataset.slideIndex; // 0,1,2…

				// pin every slide into place for one viewport's worth,
				// then scrub its x% from 100→0
				ScrollTrigger.create({
					trigger: slide,
					start: () => `top top+=70`,                // when top of slide hits 70px from top
					end:   () => `+=${window.innerHeight - 70}`, // scroll distance = one screen under header
					scrub: true,
					pin: true,
					pinSpacing: false,
					onUpdate: (self) => {
						// self.progress is 0→1 through this block; map 1→0 so it comes in from right
						const x = 100 * (1 - self.progress);
						slide.style.transform = `translateX(${x}%)`;
					}
				});
			});

			document.addEventListener('alpine:init', () => {
				Alpine.data('articleChrome', () => ({
					progress: 0,
					revealed: false,
					init() {
						this.onScroll = this.onScroll.bind(this);
						window.addEventListener('scroll', this.onScroll, { passive: true });
						window.addEventListener('resize', this.onScroll);
						this.onScroll();
					},
					destroy() {
						window.removeEventListener('scroll', this.onScroll);
						window.removeEventListener('resize', this.onScroll);
					},
					onScroll() {
						const doc = document.documentElement;
						const max = doc.scrollHeight - doc.clientHeight;
						this.progress = max > 0 ? Math.min(100, (doc.scrollTop / max) * 100) : 0;
						// Reveal the header title once we've scrolled most of the hero away.
						this.revealed = window.scrollY > (window.innerHeight - 140);
					},
				}));
			});

			document.addEventListener("alpine:init", () => {
				Alpine.data("animateOnScroll", () => ({
					observer: null,
					init() {
						// Configure the IntersectionObserver to trigger when 20% of the element is visible
						this.observer = new IntersectionObserver(
							(entries) => {
								entries.forEach((entry) => {
									if (entry.intersectionRatio >= 0.1) { // Trigger when 20% visible
										const target = entry.target;
										target.setAttribute("data-in-view", "true"); // Let CSS know the element is in view.
										this.observer.unobserve(target); // Stop observing once animated
									}
								});
							},
							{
								threshold: 0.2, // 20% visibility
							}
						);

						// Observe each element with the `data-animate` attribute
						document.querySelectorAll("[data-animate='true']").forEach((el) => {
							this.observer.observe(el);
						});
					},
				}));
			});

			document.addEventListener('alpine:init', () => {
				Alpine.data('scrollZoom', (animation, url, position) => ({
					scale: animation === 'zoomout' ? 1.05 : 1,
					url,
					position,
					init() {
						this.update = this.update.bind(this) // ✅ bind this context
						window.addEventListener('scroll', this.update)
						this.update()
					},
					destroy() {
						window.removeEventListener('scroll', this.update)
					},
					update() {
						if (!this.$el) return; // ✅ safety check

						const rect = this.$el.getBoundingClientRect()
						const windowHeight = window.innerHeight || document.documentElement.clientHeight

						if (rect.top < windowHeight && rect.bottom > 0) {
							const scrollProgress = 1 - Math.abs(rect.top) / windowHeight
							const clamped = Math.max(0, Math.min(scrollProgress, 1))

							if (animation === 'zoomin') {
								this.scale = 1.05 - (0.05 * clamped)
							} else if (animation === 'zoomout') {
								this.scale = 1 + (0.05 * (1 - clamped))
							}
						}
					}
				}))
			})

			document.addEventListener('alpine:init', () => {
				Alpine.data('heroAnimate', () => ({
					init() {
						setTimeout(() => {
							this.$el.querySelectorAll('[data-animate]').forEach(el => el.setAttribute('data-in-view', 'true'));
						}, 50);
					}
				}));
			});

			document.addEventListener('alpine:init', () => {
				Alpine.data('insetImageParallax', () => ({
					offset: 0,
					frame: null,
					reducedMotion: false,
					init() {
						this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
						this.update = this.update.bind(this)
						window.addEventListener('scroll', this.update, { passive: true })
						window.addEventListener('resize', this.update)
						this.update()
					},
					destroy() {
						window.removeEventListener('scroll', this.update)
						window.removeEventListener('resize', this.update)
						if (this.frame) {
							cancelAnimationFrame(this.frame)
						}
					},
					update() {
						if (this.reducedMotion || !this.$el || this.frame) {
							return
						}

						this.frame = requestAnimationFrame(() => {
							const rect = this.$el.getBoundingClientRect()
							const windowHeight = window.innerHeight || document.documentElement.clientHeight
							const viewportCenter = windowHeight / 2
							const elementCenter = rect.top + (rect.height / 2)
							const distance = (viewportCenter - elementCenter) / windowHeight

							this.offset = Math.max(-55, Math.min(55, distance * 110))
							this.frame = null
						})
					},
				}))
			})
		</script>

        {{ function('wp_footer') }}
        {% do action('get_footer') %}
    </body>
</html>
