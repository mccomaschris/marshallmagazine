<head>
    <meta charset="{{ site.charset }}" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="profile" href="http://gmpg.org/xfn/11" />
    {% do action('get_header') %}
    {{ function('wp_head') }}

	{# Fathom Analytics #}
	<script src="https://cdn.usefathom.com/script.js" data-site="ZQZGHLNR" defer></script>

	{# Custom Fonts #}
	<style>
		.photos-section {
			position: relative;
			overflow: hidden;
		}
		.photo-slide {
			position: absolute;
			top: 70px;
			left: 0;
			width: 100%;
			height: calc(100vh - 70px);
			background-size: cover;
			background-position: center;
		}
		/* wrapper that gives you N screens of scroll */
		.photos-wrapper {
			height: calc((100vh - 70px) * var(--count));
		}
	</style>

	{# Adobe Typekit #}
	<link rel="preconnect" href="https://use.typekit.net">
	<link rel="stylesheet" href="https://use.typekit.net/tnv6zvq.css">

	{# Alpine.js Plugins #}
	<script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/focus@3.x.x/dist/cdn.min.js"></script>
	<script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/intersect@3.x.x/dist/cdn.min.js"></script>
	<script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/collapse@3.x.x/dist/cdn.min.js"></script>
	<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

	{# GSAP #}
	<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
</head>
