{#
/**
 * Feature Links Partial
 *
 * A set of featured "read more" style links, distinct from inline body links.
 * Rendered as a responsive grid of bordered cards. Expects:
 *   layout — the flexible-content `feature_links` layout, with:
 *              heading  — optional group heading
 *              links    — repeater of { link (ACF link array), description (text) }
 *   bg     — parent block background ('white' | 'green' | 'black'), defaults to 'white'
 *
 * @package herdline
 */
#}

{% set rule_class    = 'border-gray-900/10' %}
{% set label_class   = 'text-gray-900 group-hover:text-green' %}
{% set desc_class    = 'text-gray-500' %}
{% set arrow_class   = 'text-green' %}
{% set kicker_class  = 'text-green' %}
{% set card_bg       = 'bg-gray-900/[0.03]' %}
{% set card_border   = 'border-gray-900/10' %}
{% set card_hover    = 'hover:border-green hover:bg-green/[0.04]' %}

{% if bg == 'green' %}
    {% set rule_class    = 'border-white/20' %}
    {% set label_class   = 'text-white group-hover:text-white' %}
    {% set desc_class    = 'text-white/70' %}
    {% set arrow_class   = 'text-white' %}
    {% set kicker_class  = 'text-white' %}
    {% set card_bg       = 'bg-white/[0.06]' %}
    {% set card_border   = 'border-white/20' %}
    {% set card_hover    = 'hover:border-white hover:bg-white/[0.10]' %}
{% elseif bg == 'black' %}
    {% set rule_class    = 'border-white/15' %}
    {% set label_class   = 'text-white group-hover:text-green-bright' %}
    {% set desc_class    = 'text-gray-300' %}
    {% set arrow_class   = 'text-green-bright' %}
    {% set kicker_class  = 'text-green-bright' %}
    {% set card_bg       = 'bg-white/[0.04]' %}
    {% set card_border   = 'border-white/15' %}
    {% set card_hover    = 'hover:border-green-bright hover:bg-green-bright/[0.06]' %}
{% endif %}

{% if layout.links %}
    <div class="my-12 lg:my-16" data-animate="true">
        {% if layout.heading %}
            <div class="mb-5 flex items-center gap-3">
                <span class="text-xs font-semibold uppercase tracking-[0.18em] {{ kicker_class }}">{{ layout.heading }}</span>
                <span class="h-px flex-1 border-t {{ rule_class }}"></span>
            </div>
        {% endif %}

        <ul class="m-0 grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2">
            {% for item in layout.links %}
                {% if item.link.url %}
                    <li class="m-0">
                        <a
                            href="{{ item.link.url }}"
                            class="group flex h-full flex-col rounded-lg border {{ card_border }} {{ card_bg }} p-5 no-underline transition-colors {{ card_hover }}"
                            {% if item.link.target %}target="{{ item.link.target }}" rel="noopener"{% endif %}
                        >
                            <span class="flex items-start justify-between gap-3">
                                <span class="font-sans text-lg font-semibold leading-snug transition-colors {{ label_class }}">
                                    {{ item.link.title ?: item.link.url }}
                                </span>
                                <svg class="mt-1 size-5 flex-none transition-transform duration-300 ease-fluid group-hover:translate-x-1 {{ arrow_class }}" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
                            </span>
                            {% if item.description %}
                                <span class="mt-2 font-sans text-base leading-6 {{ desc_class }}">{{ item.description }}</span>
                            {% endif %}
                        </a>
                    </li>
                {% endif %}
            {% endfor %}
        </ul>
    </div>
{% endif %}
