{#
/**
 * Pull Quote Partial
 *
 * Rendered inside the Basic Content reading column (.content-block--editorial).
 * Expects:
 *   pull_quote.quote            — the quote text
 *   pull_quote.attribution      — name / source
 *   pull_quote.sub_attribution  — role / detail (optional)
 *   bg                          — parent block background ('white' | 'green' | 'black')
 *
 * @package herdline
 */
#}

{# Accents adapt to the parent block background so the pull quote stays legible. #}
{% set qBorder = 'border-green' %}
{% set qBg     = 'bg-green/5' %}
{% set qText   = 'text-gray-900' %}
{% set qAccent = 'text-green' %}
{% set qAttr   = 'text-gray-500' %}

{% if bg == 'green' %}
	{% set qBorder = 'border-white/50' %}
	{% set qBg     = 'bg-white/10' %}
	{% set qText   = 'text-white' %}
	{% set qAccent = 'text-green-bright' %}
	{% set qAttr   = 'text-white/70' %}
{% elseif bg == 'black' %}
	{% set qBorder = 'border-green-bright' %}
	{% set qBg     = 'bg-white/5' %}
	{% set qText   = 'text-white' %}
	{% set qAccent = 'text-green-bright' %}
	{% set qAttr   = 'text-gray-300' %}
{% endif %}

{% if pull_quote.quote %}
	<figure data-animate="true" class="my-12 lg:my-16">
		<blockquote class="{{ qBg }} border-l-[3px] {{ qBorder }} px-8 py-10 lg:py-14">
			<div class="font-serif text-2xl lg:text-3xl/snug {{ qText }} italic text-balance">{{ pull_quote.quote }}</div>
			{% if pull_quote.attribution %}
				<figcaption class="mt-5 font-sans text-xs font-semibold not-italic tracking-[0.2em] uppercase {{ qAccent }}">
					{{ pull_quote.attribution }}
					{% if pull_quote.sub_attribution %}
						<span class="block mt-1 font-sans text-sm font-normal normal-case tracking-normal {{ qAttr }}">{{ pull_quote.sub_attribution }}</span>
					{% endif %}
				</figcaption>
			{% endif %}
		</blockquote>
	</figure>
{% endif %}
