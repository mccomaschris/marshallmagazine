{#
/**
 * Pull Quote Partial
 *
 * Rendered inside the Basic Content reading column (.content-block--editorial).
 * Expects:
 *   pull_quote.quote            — the quote text
 *   pull_quote.attribution      — name / source
 *   pull_quote.sub_attribution  — role / detail (optional)
 *   bg                          — parent block background ('white' | 'green' | 'black')
 *
 * @package herdline
 */
#}

{# Accents adapt to the parent block background so the pull quote stays legible. #}
{% set qText   = 'text-gray-900' %}
{% set qAccent = 'text-green' %}
{% set qAttr   = 'text-gray-500' %}
{% set qPanel  = 'bg-green-light ring-1 ring-green/10' %}

{% if bg == 'green' %}
	{% set qText   = 'text-white' %}
	{% set qAccent = 'text-green-bright' %}
	{% set qAttr   = 'text-white/70' %}
	{% set qPanel  = 'bg-white/10 ring-1 ring-white/15' %}
{% elseif bg == 'black' %}
	{% set qText   = 'text-white' %}
	{% set qAccent = 'text-green-bright' %}
	{% set qAttr   = 'text-gray-300' %}
	{% set qPanel  = 'bg-white/5 ring-1 ring-white/10' %}
{% endif %}

{% if pull_quote.quote %}
	<figure data-animate="true" class="my-12 lg:my-16 overflow-hidden rounded-lg {{ qPanel }}">
		<div class="flex gap-5 lg:gap-6 p-7 lg:p-9">
			<span aria-hidden="true" class="font-serif leading-[0.7] select-none {{ qAccent }} text-6xl lg:text-7xl">&ldquo;</span>
			<div>
				<blockquote class="m-0">
					<div class="font-serif font-medium {{ qText }} text-2xl lg:text-3xl leading-[1.3] tracking-tight text-balance">{{ pull_quote.quote }}</div>
				</blockquote>
				{% if pull_quote.attribution %}
					<figcaption class="mt-5 font-science text-base font-bold uppercase tracking-[0.18em] {{ qAccent }}">
						{{ pull_quote.attribution }}
						{% if pull_quote.sub_attribution %}
							<span class="block mt-1 font-sans text-sm font-normal normal-case tracking-normal {{ qAttr }}">{{ pull_quote.sub_attribution }}</span>
						{% endif %}
					</figcaption>
				{% endif %}
			</div>
		</div>
	</figure>
{% endif %}
