{#
/**
 * Photos Block
 *
 * @package herdline
 */
#}
{% if fields.display_type == 'polaroid' %}
	{# ─── Staggered offset ───────────────────────────────────────────────
	   Uniform 4:5 cards on a clean field with a column-based vertical offset
	   for an editorial brick rhythm. Captions sit beneath a hairline rule. #}

	{# Background + caption accents. Empty/legacy values fall through to white. #}
	{% set bgColor = 'bg-white' %}
	{% set sideRule = 'bg-gray-900' %}
	{% set sideCaption = 'text-gray-500' %}
	{% set imgPlaceholder = 'bg-gray-200' %}

	{% if fields.background_color == 'green' %}
		{% set bgColor = 'bg-green' %}
		{% set sideRule = 'bg-white' %}
		{% set sideCaption = 'text-white/70' %}
		{% set imgPlaceholder = 'bg-black/10' %}
	{% elseif fields.background_color == 'black' %}
		{% set bgColor = 'bg-gray-900' %}
		{% set sideRule = 'bg-white' %}
		{% set sideCaption = 'text-gray-300' %}
		{% set imgPlaceholder = 'bg-gray-800' %}
	{% elseif fields.background_color == 'gray' %}
		{% set bgColor = 'bg-gray-100' %}
		{% set sideRule = 'bg-gray-900' %}
		{% set sideCaption = 'text-gray-500' %}
		{% set imgPlaceholder = 'bg-gray-300' %}
	{% endif %}

	<section
		data-block-type="photos"
		class="{{ bgColor }} py-16 lg:py-28 {{ block_classes }}"
		{% if anchor %}id="{{ anchor }}"{% endif %}
	>
		<div class="container mx-auto px-6 lg:px-8">
			{% if fields.photos %}
				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 items-start gap-x-6 gap-y-12 lg:gap-x-10">
					{% for item in fields.photos %}
						{% if item.photo %}
							{% set focal_point = item.photo.id|focal_point %}
							{% set offsets = ['lg:mt-0', 'lg:mt-16', 'lg:mt-28'] %}
							<figure
								data-animate="true"
								class="mb-0 {{ offsets[loop.index0 % 3] }}"
							>
								<div class="group relative overflow-hidden aspect-[4/5] {{ imgPlaceholder }} shadow-sm transition-shadow duration-500 hover:shadow-xl">
									<img
										src="{{ item.photo.sizes.medium_large }}"
										srcset="{{ item.photo.sizes.medium_large }} 768w, {{ item.photo.sizes.large }} 1024w"
										sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
										alt="{{ item.photo.alt }}"
										loading="lazy"
										class="h-full w-full object-cover transition-transform duration-700 ease-fluid group-hover:scale-105"
										style="object-position: {{ focal_point }};"
									/>
								</div>
								{% if item.cover_text or item.photo_credit %}
									{# Caption tethered to its image by a rounded accent rail — matches the side images in basic-content. #}
									<figcaption class="mt-4 flex gap-3">
										<span class="w-1 flex-none self-stretch rounded-full {{ sideRule }}"></span>
										<div class="font-sans text-[0.95rem] font-medium leading-snug {{ sideCaption }}">
											{% if item.cover_text %}
												<span class="block">{{ item.cover_text }}</span>
											{% endif %}
											{% if item.photo_credit %}
												<span class="mt-1 block font-science text-[11px] font-normal uppercase tracking-widest">Photo by {{ item.photo_credit }}</span>
											{% endif %}
										</div>
									</figcaption>
								{% endif %}
							</figure>
						{% endif %}
					{% endfor %}
				</div>
			{% endif %}
		</div>
	</section>
{% elseif fields.display_type == 'scroll' %}
	{# ─── Cinematic scroll ───────────────────────────────────────────────
	   Full-height, edge-to-edge filmstrip with horizontal scroll-snap.
	   Each frame fills most of the viewport; captions overlay a scrim. #}
	<section
		data-block-type="photos"
		class="relative bg-gray-900 {{ block_classes }}"
		{% if anchor %}id="{{ anchor }}"{% endif %}
	>
		{% if fields.photos %}
			<div class="flex h-[calc(100svh-70px)] snap-x snap-mandatory overflow-x-auto overflow-y-hidden scroll-smooth">
				{% for item in fields.photos %}
					{% if item.photo %}
						{% set focal_point = item.photo.id|focal_point %}
						<figure class="relative m-0 shrink-0 snap-center w-[88vw] lg:w-[72vw] h-full">
							<img
								src="{{ item.photo.sizes.large }}"
								srcset="{{ item.photo.sizes.medium_large }} 768w, {{ item.photo.sizes.large }} 1024w, {{ item.photo.url }} 1600w"
								sizes="(min-width: 1024px) 72vw, 88vw"
								alt="{{ item.photo.alt }}"
								loading="lazy"
								class="h-full w-full object-cover"
								style="object-position: {{ focal_point }};"
							/>
							{% if item.cover_text or item.photo_credit %}
								<div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black/80 via-black/30 to-transparent pointer-events-none"></div>
								<figcaption class="absolute inset-x-0 bottom-0 px-6 pb-16 lg:px-12 lg:pb-20">
									<div class="max-w-2xl">
										{% if item.cover_text %}
											<div class="h-1 w-12 bg-green-bright mb-4"></div>
											<p class="font-sans text-white text-2xl lg:text-3xl leading-snug font-medium text-shadow">{{ item.cover_text }}</p>
										{% endif %}
										{% if item.photo_credit %}
											<p class="mt-3 font-science text-xs uppercase tracking-widest text-white/70">Photo by {{ item.photo_credit }}</p>
										{% endif %}
									</div>
								</figcaption>
							{% endif %}
							<div class="absolute top-6 right-6 font-science text-xs uppercase tracking-widest text-white/60">
								{{ loop.index }} / {{ loop.length }}
							</div>
						</figure>
					{% endif %}
				{% endfor %}
			</div>
			<div class="pointer-events-none absolute bottom-6 left-1/2 -translate-x-1/2 flex items-center gap-2 font-science text-[11px] uppercase tracking-widest text-white/60">
				<span>Scroll</span>
				<svg class="size-4 -rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
			</div>
		{% endif %}
	</section>
{% else %}
	{% if fields.photos %}
		{% for item in fields.photos %}
			{% if item.photo %}
				{% set placementClass = 'items-center' %}

				{% if item.text_placement == 'topcenter' %}
					{% set placementClass = 'items-start' %}
				{% elseif item.text_placement == 'bottomcenter' %}
					{% set placementClass = 'items-end' %}
				{% endif %}

				{% set focal_point = item.photo.id|focal_point %}
				<div
					{% if fields.fade_from_grayscale_to_color %}
						x-data="{ visible: false }"
						x-intersect.once.half="visible = true"
						:class="visible ? 'grayscale-0' : 'grayscale'"
					{% endif %}
					data-block-type="photo-break"
					class="h-[calc(100svh-70px)] md:bg-fixed bg-center bg-cover relative snap-start transition-all duration-1000 ease-linear delay-500 {{ block_classes }}"
					style="
						background-image: url({{ item.photo.url }});
						background-position: {{ focal_point }};
					"
					{% if anchor and loop.first %}id="{{ anchor }}"{% endif %}
				>
					{% if item.cover_text %}
						{# Editorial caption — serif statement, lower-left over a gradient scrim #}
						<div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black/80 via-black/40 to-transparent pointer-events-none"></div>
						<div data-animate="true" class="absolute inset-x-0 bottom-0 px-6 pb-24 lg:px-16 lg:pb-28">
							<div class="max-w-3xl">
								<div class="h-1 w-12 bg-green-bright mb-5"></div>
								<p class="font-sans text-white text-2xl lg:text-4xl leading-snug font-medium text-shadow">{{ item.cover_text }}</p>
							</div>
						</div>
					{% endif %}

					{% if item.photo_credit %}
						<div data-animate="true" class="delay-300! absolute bottom-5 right-5 lg:bottom-6 lg:right-8 font-science text-xs lg:text-sm text-white/75 text-shadow">
							Photo by {{ item.photo_credit }}
						</div>
					{% endif %}

					<div class="scroll-indicator absolute bottom-8 left-1/2 -translate-x-1/2 w-12 h-12 lg:h-16 lg:w-16 rounded-full bg-gray-900/30 backdrop-blur-sm flex items-center justify-center">
						<svg class="size-6 lg:size-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
						</svg>
					</div>
				</div>
			{% endif %}
		{% endfor %}
	{% endif %}
{% endif %}
