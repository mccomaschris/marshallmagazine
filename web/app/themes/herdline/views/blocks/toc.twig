{#
/**
 * Table of Contents Block — Visual Cover Grid
 *
 * Image-forward issue index of hand-picked stories grouped into labelled
 * sections. Each section's layout adapts to how many stories it holds: a single
 * story runs as a full-width feature, small sets sit in a balanced card grid,
 * and larger sets lead with a feature followed by a card grid.
 *
 * Expected context (built in callback.php, mirroring more-stories):
 *   intro_label   string  Eyebrow label, defaults to "Contents".
 *   issue_label   string  Issue name; falls back to the page title if empty.
 *   sections      array   [ { label: string, basic_grid: bool, stories: [ {
 *                           title, url, id, hero_image, subheading,
 *                           description, author, story_type
 *                         } ] } ]
 *                         basic_grid forces a uniform 3-up grid for the section;
 *                         otherwise the layout adapts to the story count.
 *   block_classes string
 *   anchor        string
 *
 * @package herdline
 */
#}

{# Returns the display label for a story type (used as the tile kicker). #}
{% macro type_label(story_type) %}
	{%- if story_type == 'student' -%}Student Spotlight
	{%- elseif story_type == 'staff' -%}Staff Spotlight
	{%- elseif story_type == 'alum' -%}Alum Spotlight
	{%- elseif story_type == 'athletics' -%}Athletics Spotlight
	{%- elseif story_type == 'faculty' -%}Faculty Feature
	{%- elseif story_type == 'board' -%}Board of Governors Feature
	{%- endif -%}
{% endmacro %}

{# A story tile: full-bleed image with overlaid kicker, title and dek
   (matches the "Keep Reading" tiles in templates/page.twig).
   prominent bumps the type scale for "Featured" sections. #}
{% macro card(story, prominent = false) %}
	{% import _self as toc %}
	{% set kicker = toc.type_label(story.story_type)|trim %}
	<a href="{{ story.url }}" data-animate="true" class="group relative block overflow-hidden rounded-sm aspect-[3/4]">
		{% if story.hero_image %}
			<img
				src="{{ story.hero_image.src('large') }}"
				srcset="{{ story.hero_image.src('medium_large') }} 768w, {{ story.hero_image.src('large') }} 1024w, {{ story.hero_image.src('full') }} 2000w"
				sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
				alt="{{ story.title }}"
				loading="lazy"
				style="object-position: {{ story.hero_image.id|focal_point }};"
				class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1200ms] ease-fluid group-hover:scale-[1.06]"
			/>
		{% else %}
			<div class="absolute inset-0 bg-gradient-to-br from-green-dark to-green-darkest"></div>
		{% endif %}
		<div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent"></div>
		<div class="absolute inset-x-0 bottom-0 {{ prominent ? 'p-6 lg:p-8' : 'p-5' }}">
			{% if kicker %}
				<span class="block font-science {{ prominent ? 'text-xs lg:text-sm' : 'text-xs' }} font-bold uppercase tracking-[0.25em] text-green-bright">{{ kicker }}</span>
			{% endif %}
			<h3 class="mt-2 font-serif {{ prominent ? 'text-2xl lg:text-4xl leading-[1.1]' : 'text-lg lg:text-2xl leading-snug' }} text-white text-balance">{{ story.title }}</h3>
			{% if story.description or story.subheading %}
				<p class="mt-2 font-system {{ prominent ? 'text-sm lg:text-base' : 'text-sm' }} leading-snug text-white/75 line-clamp-2">{{ story.description ?: story.subheading }}</p>
			{% endif %}
			{% if story.author %}
				<span class="mt-2 block font-science {{ prominent ? 'text-xs lg:text-sm' : 'text-xs' }} uppercase tracking-[0.15em] text-white/80">By {{ story.author }}</span>
			{% endif %}
		</div>
	</a>
{% endmacro %}

{# A prominent, full-width hero tile in the same overlaid style as the cards. #}
{% macro feature(story) %}
	{% import _self as toc %}
	{% set kicker = toc.type_label(story.story_type)|trim %}
	<a href="{{ story.url }}" data-animate="true" class="group relative block overflow-hidden rounded-sm aspect-[4/3] sm:aspect-[16/9] lg:aspect-[21/9]">
		{% if story.hero_image %}
			<img
				src="{{ story.hero_image.src('large') }}"
				srcset="{{ story.hero_image.src('large') }} 1024w, {{ story.hero_image.src('full') }} 1600w"
				sizes="100vw"
				alt="{{ story.title }}"
				loading="lazy"
				style="object-position: {{ story.hero_image.id|focal_point }};"
				class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1200ms] ease-fluid group-hover:scale-[1.06]"
			/>
		{% else %}
			<div class="absolute inset-0 bg-gradient-to-br from-green-dark to-green-darkest"></div>
		{% endif %}
		<div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent"></div>
		<div class="absolute inset-x-0 bottom-0 p-6 lg:p-10">
			{% if kicker %}
				<span class="block font-science text-xs lg:text-sm font-bold uppercase tracking-[0.25em] text-green-bright">{{ kicker }}</span>
			{% endif %}
			<h3 class="mt-2 font-serif text-3xl lg:text-5xl leading-[1.05] text-white text-balance max-w-3xl">{{ story.title }}</h3>
			{% if story.description or story.subheading %}
				<p class="mt-3 font-system text-base lg:text-lg leading-snug text-white/80 max-w-2xl line-clamp-2">{{ story.description ?: story.subheading }}</p>
			{% endif %}
			{% if story.author %}
				<span class="mt-3 block font-science text-xs lg:text-sm uppercase tracking-[0.15em] text-white/80">By {{ story.author }}</span>
			{% endif %}
		</div>
	</a>
{% endmacro %}

{% import _self as toc %}

<div
	data-block-type="table_of_contents"
	class="{{ block_classes }}"
	{% if anchor %}id="{{ anchor }}"{% endif %}
>
	<section class="py-16 lg:py-28 bg-white">
		<div class="container mx-auto px-6 max-w-6xl">

			{# Header #}
			<header data-animate="true" class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between border-b border-gray-900/15 pb-6">
				<h2 class="font-science font-bold text-3xl lg:text-5xl tracking-[-0.02em] text-gray-800 leading-none">
					{{ intro_label ?: 'Contents' }}
				</h2>
				<span class="font-system text-base tracking-[0.18em] uppercase text-green">
					{{ issue_label ?: post.title }}
				</span>
			</header>

			{% if sections %}
				{% for section in sections %}
					{% if section.stories %}
						{% set n = section.stories|length %}
						{% set is_featured = section.label|lower|trim in ['featured', 'features'] %}
						<div class="mt-14 lg:mt-20">

							{% if section.label %}
								<div class="flex items-center gap-4 mb-6">
									<h3 class="shrink-0 font-system text-base font-bold uppercase text-green tracking-[0.11em]">
										{{ section.label }}
									</h3>
									<span class="h-px flex-1 bg-gray-900/15"></span>
								</div>
							{% endif %}

							{# basic_grid forces a uniform 3-up grid; otherwise the layout adapts
							   to story count so small sections (1–4 features) stay balanced and
							   large sections lead with a feature. #}
							{% if section.basic_grid %}
								<div class="animate-group grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
									{% for story in section.stories %}
										{{ toc.card(story, is_featured) }}
									{% endfor %}
								</div>
							{% elseif n == 1 %}
								<div class="animate-group">
									{{ toc.feature(section.stories|first) }}
								</div>
							{% elseif n >= 5 %}
								<div class="animate-group">
									{{ toc.feature(section.stories|first) }}
									<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12 mt-12 lg:mt-16">
										{% for story in section.stories|slice(1) %}
											{{ toc.card(story, is_featured) }}
										{% endfor %}
									</div>
								</div>
							{% else %}
								{% set grid = n == 2 ? 'grid-cols-1 sm:grid-cols-2' : n == 3 ? 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3' : 'grid-cols-1 sm:grid-cols-2' %}
								<div class="animate-group grid {{ grid }} gap-x-8 gap-y-12">
									{% for story in section.stories %}
										{{ toc.card(story, is_featured) }}
									{% endfor %}
								</div>
							{% endif %}

						</div>
					{% endif %}
				{% endfor %}
			{% endif %}

		</div>
	</section>
</div>
