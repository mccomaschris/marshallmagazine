{#
/**
 * Separator Block
 *
 * Quiet, neutral break between stacked blocks (e.g. consecutive basic-content
 * blocks) so the transition reads intentionally instead of as a gap of
 * whitespace. The next section's heading does the labeling, so the non-photo
 * treatments are text-free. Pick a treatment per-instance with the `style`
 * field; the drone photo is the one "feature" spot and takes an optional label.
 *
 * @package herdline
 */
#}

{% set sep_style = fields.style ?: 'asterism' %}
{% set sep_label = fields.label %}
{% set sep_image = fields.background_image %}
{% set sep_focal = sep_image ? sep_image.id|focal_point : '50% 50%' %}

{# Soft radial fade so the CSS patterns concentrate in the center and dissolve
   toward the edges instead of hard-cutting at the block bounds. #}
{% set pattern_mask = '-webkit-mask-image: radial-gradient(ellipse 70% 120% at 50% 50%, #000 28%, transparent 78%); mask-image: radial-gradient(ellipse 70% 120% at 50% 50%, #000 28%, transparent 78%);' %}

{% if sep_style == 'photo' %}
    {# Drone photo + overlay — the one "feature" spot; label optional. #}
    <div
        class="relative flex items-end min-h-[45svh] lg:min-h-[55svh] bg-gray-900 bg-cover bg-center {{ block_classes }}"
        data-block-type="separator"
        {% if sep_image %}style="background-image: url('{{ sep_image.url }}'); background-position: {{ sep_focal }}"{% endif %}
        {% if anchor %}id="{{ anchor }}"{% endif %}
    >
        <div class="absolute inset-0 bg-gradient-to-t from-green-darkest/85 via-green-darkest/35 to-green-darkest/10" aria-hidden="true"></div>
        {% if sep_label %}
            <div class="relative z-10 container mx-auto px-8 lg:px-0 pb-10 lg:pb-14">
                <div data-animate="true" class="flex items-center gap-4 text-white">
                    <span class="h-px w-10 lg:w-16 bg-green-bright"></span>
                    <span class="font-science font-bold text-sm uppercase tracking-[0.2em]">{{ sep_label }}</span>
                </div>
            </div>
        {% endif %}
    </div>

{% elseif sep_style == 'center_rule' %}
    {# Center-mark rule — a full-measure hairline pinned by a bold diamond node. #}
    <div class="relative py-4 lg:py-8 bg-white {{ block_classes }}" data-block-type="separator" {% if anchor %}id="{{ anchor }}"{% endif %}>
        <div data-animate="true" class="container mx-auto px-8 lg:px-0">
            <div class="flex items-center justify-center gap-8">
                <span class="h-px flex-1 bg-gray-900/15"></span>
                <span class="h-4 w-4 lg:h-5 lg:w-5 shrink-0 rotate-45 bg-green"></span>
                <span class="h-px flex-1 bg-gray-900/15"></span>
            </div>
        </div>
    </div>

{% elseif sep_style == 'dots' %}
    {# Dot grid — an even field of fine green dots, faded toward the edges. #}
    <div class="relative py-16 lg:py-20 bg-white overflow-hidden {{ block_classes }}" data-block-type="separator" {% if anchor %}id="{{ anchor }}"{% endif %}>
        <div class="absolute inset-0" style="background-image: radial-gradient(circle, rgba(0,172,62,0.32) 1.5px, transparent 1.6px); background-size: 22px 22px; {{ pattern_mask }}" aria-hidden="true"></div>
    </div>

{% elseif sep_style == 'diagonal' %}
    {# Diagonal lines — a fine pinstripe hatch, faded toward the edges. #}
    <div class="relative py-16 lg:py-20 bg-white overflow-hidden {{ block_classes }}" data-block-type="separator" {% if anchor %}id="{{ anchor }}"{% endif %}>
        <div class="absolute inset-0" style="background-image: repeating-linear-gradient(45deg, rgba(0,172,62,0.16) 0, rgba(0,172,62,0.16) 1px, transparent 1px, transparent 11px); {{ pattern_mask }}" aria-hidden="true"></div>
    </div>

{% elseif sep_style == 'grid' %}
    {# Grid lines — a fine graph rule in neutral ink, faded toward the edges. #}
    <div class="relative py-16 lg:py-20 bg-white overflow-hidden {{ block_classes }}" data-block-type="separator" {% if anchor %}id="{{ anchor }}"{% endif %}>
        <div class="absolute inset-0" style="background-image: linear-gradient(rgba(17,24,39,0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(17,24,39,0.07) 1px, transparent 1px); background-size: 30px 30px; {{ pattern_mask }}" aria-hidden="true"></div>
    </div>

{% else %}
    {# Asterism — a scaled-up three-diamond typographic ornament (default). #}
    <div class="relative py-16 lg:py-20 bg-white {{ block_classes }}" data-block-type="separator" {% if anchor %}id="{{ anchor }}"{% endif %}>
        <div data-animate="true" class="flex items-center justify-center gap-6 lg:gap-8 text-green">
            <span class="h-3 w-3 rotate-45 bg-current"></span>
            <span class="h-4 w-4 lg:h-5 lg:w-5 rotate-45 bg-current"></span>
            <span class="h-3 w-3 rotate-45 bg-current"></span>
        </div>
    </div>

{% endif %}
