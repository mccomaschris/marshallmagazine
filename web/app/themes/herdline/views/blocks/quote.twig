{#
/**
 * Quote Block
 *
 * @package herdline
 */
#}

{# Set default classes #}
{% set bgClasses = "" %}
{% set svgClasses = "text-green-darkest/80" %}
{% set textClasses = "text-white" %}
{% set placementClass = "justify-center" %}

{# Background logic #}
{% if fields.background == "color" %}
    {% if fields.background_color == "green" %}
        {% set bgClasses = "bg-gradient-to-b from-green-dark to-green md:bg-fixed" %}
    {% elseif fields.background_color == "black" %}
        {% set bgClasses = "bg-gradient-to-b from-gray-900 to-gray-700 md:bg-fixed" %}
        {% set svgClasses = "text-green-bright" %}
    {% elseif fields.background_color == "white" %}
        {% set bgClasses = "bg-gradient-to-b from-gray-50 to-white md:bg-fixed" %}
        {% set svgClasses = "text-green-darkest/20" %}
        {% set textClasses = "text-green" %}
    {% endif %}
{% elseif fields.background == "image" %}
    {% set bgClasses = "lg:bg-fixed bg-cover bg-center" %}
    {% set svgClasses = "text-green-darkest" %}
    {% if fields.add_overlay_to_image %}
        {% set svgClasses = "text-white" %}
    {% endif %}
    {% if fields.quote_vertical_placement == "topcenter" %}
        {% set placementClass = "justify-start" %}
    {% elseif fields.quote_vertical_placement == "bottomcenter" %}
        {% set placementClass = "justify-end" %}
    {% endif %}
{% endif %}

{# Background image styles #}
{% if fields.background == "image" and fields.background_image %}
    {% set focal_point = fields.background_image.id|focal_point %}
{% endif %}

<!-- Quote Block -->
<div
    class="{{ fields.fit_content ? 'py-24 lg:py-36' : 'min-h-[calc(100svh-70px)] lg:h-[calc(100svh-70px)] py-12 lg:py-24' }} flex flex-col {{ placementClass }} text-white relative {{ bgClasses }} {{ block_classes }}"
    style="
        {% if fields.background == 'image' and fields.background_image %}
            background-image: url({{ fields.background_image.url }});
            background-position: {{ focal_point }};
        {% endif %}
    "
    data-block-type="quote"
    {% if anchor %}id="{{ anchor }}"{% endif %}
>
    {# Full-bleed scrim over the image keeps the photo visible while making the quote legible #}
    {% if fields.background == "image" and fields.add_overlay_to_image %}
        <div class="absolute inset-0 z-0 bg-gradient-to-b from-green-darkest/45 via-green-darkest/55 to-green-darkest/70"></div>
    {% endif %}

    <div class="relative z-10 w-full max-w-[640px]
        {% if fields.quote_placement == 'right' %}
            ml-auto pr-16 pl-8 lg:pl-0
        {% elseif fields.quote_placement == 'center' %}
            mx-auto px-8 lg:px-0
        {% else %}
            pl-16 pr-8 lg:pr-0
        {% endif %}"
    >
        <div data-animate="true" class="text-center {{ textClasses }}">
            <span aria-hidden="true" class="block font-serif leading-none text-[9rem] lg:text-[12rem] {{ svgClasses }}">&ldquo;</span>

            <blockquote class="font-serif font-medium tracking-tight text-3xl lg:text-5xl leading-[1.15] -mt-6 lg:-mt-10 [&_p]:m-0 [&_p+p]:mt-6">
                {{ fields.quote|raw }}
            </blockquote>

            {% if fields.attribution %}
                <div class="mt-10 flex items-center justify-center gap-4">
                    <span class="h-px w-8 bg-current opacity-40"></span>
                    <div>
                        <div class="font-science font-bold text-sm uppercase tracking-[0.2em]">{{ fields.attribution }}</div>
                        {% if fields.sub_attribution %}
                            <div class="font-science text-xs uppercase tracking-[0.15em] opacity-70 mt-1.5">{{ fields.sub_attribution }}</div>
                        {% endif %}
                    </div>
                    <span class="h-px w-8 bg-current opacity-40"></span>
                </div>
            {% endif %}
        </div>
    </div>
</div>
