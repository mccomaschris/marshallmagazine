{#
/**
 * Hero Block
 *
 * Three modes, driven by the `hero_type` ACF button-group field:
 *   - hero_type = 'feature' → full-viewport "Editorial lower-left" hero (default)
 *   - hero_type = 'minimal' → compact minimal hero (Q&As / short stories)
 *   - hero_type = 'edition' → no hero rendered
 *
 * Defaults to 'feature' when unset, to preserve existing behavior.
 *
 * @package herdline
 */
#}
{% set hero_type = fields.hero_type ?: 'feature' %}
{% set story_type = post.meta('story_type') %}
{% set story_author = post.meta('author') %}
{% set eyebrow = fields.preheading ?: post.parent.title %}
{% set focal_point = fields.hero_image ? fields.hero_image.id|focal_point : '50% 50%' %}

{# Story-type label — shown as a badge in minimal mode, and as the editorial kicker. #}
{% set type_label = '' %}
{% if story_type == 'student' %}{% set type_label = 'Student Spotlight' %}
{% elseif story_type == 'staff' %}{% set type_label = 'Staff Spotlight' %}
{% elseif story_type == 'alum' %}{% set type_label = 'Alumni Spotlight' %}
{% elseif story_type == 'faculty' %}{% set type_label = 'Faculty Feature' %}
{% elseif story_type == 'board' %}{% set type_label = 'Board of Governors Feature' %}
{% endif %}

{# Editorial kicker: story-type label, falling back to the eyebrow (preheading/edition). #}
{% set kicker = type_label ?: eyebrow %}

{% if hero_type == 'minimal' %}

	{# ═══════════════════════════════════════════════════════════════
	   MINIMAL HERO — "Portrait split" for Q&As and short stories.
	   Text on the left, contained portrait on the right, over a brand
	   green gradient (distinct from the always-white Q&A block below).
	   Top-aligned, so it clears the fixed 70px masthead with padding.
	   ═══════════════════════════════════════════════════════════════ #}
	<section
		class="text-white bg-green-darkest bg-gradient-to-br from-green-dark via-green-darker to-green-darkest pt-[90px] pb-10 lg:pt-[110px] lg:pb-16 {{ block_classes }}"
		data-block-type="hero"
		{% if anchor %}id="{{ anchor }}"{% endif %}
	>
		<div class="container mx-auto px-8 lg:px-0">
		<div class="max-w-6xl grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
			<div class="lg:col-span-7 order-2 lg:order-1 py-2 lg:py-8">
				{# Edition / parent — same inline-rule kicker as the editorial hero. #}
				{% if eyebrow %}
					<div class="flex items-center gap-4">
						<span class="h-px w-10 bg-green-bright"></span>
						<span class="font-science text-sm font-bold uppercase tracking-[0.3em] text-green-bright">{{ eyebrow }}</span>
					</div>
				{% endif %}
				{% if not fields.hide_post_title %}
					<h1 class="mt-5 font-serif font-semibold leading-[1.05] text-white text-4xl lg:text-5xl">{{ post.title }}</h1>
				{% endif %}
				{% if fields.subheading %}
					<p class="mt-5 font-sans text-lg lg:text-2xl leading-snug text-white/85">{{ fields.subheading }}</p>
				{% endif %}
				{% if type_label %}
					<div class="mt-7">
						<span class="inline-flex items-center bg-white px-4 py-2 font-science text-xs font-bold uppercase tracking-[0.25em] text-green-darker rounded-full">{{ type_label }}</span>
					</div>
				{% endif %}

				{# Student details — label/value rows (Major, Hometown, Graduating, …). #}
				{% if fields.student_details %}
					<dl class="mt-8 max-w-md">
						{% for d in fields.student_details %}
							{% if d.detail_value %}
								<div class="border-t border-white/15 py-3.5">
									{% if d.detail_label %}
										<dt class="font-science text-[0.7rem] font-bold uppercase tracking-[0.25em] text-green-bright">{{ d.detail_label }}</dt>
									{% endif %}
									<dd class="mt-1 font-sans text-base lg:text-lg leading-snug text-white/90">{{ d.detail_value }}</dd>
								</div>
							{% endif %}
						{% endfor %}
					</dl>
				{% endif %}

				{% if story_author %}
					<p class="mt-8 font-science text-sm font-bold uppercase tracking-[0.2em] text-white/60">By {{ story_author }}</p>
				{% endif %}
			</div>

			{% if fields.hero_image %}
				<div class="lg:col-span-5 order-1 lg:order-2">
					<img src="{{ fields.hero_image.url }}" alt="{{ post.title }}" class="w-full aspect-[4/5] object-cover shadow-xl ring-1 ring-white/10" style="object-position: {{ focal_point }};">
					{% if fields.photo_credit %}
						<p class="mt-2 font-science text-xs text-white/60">Photo by {{ fields.photo_credit }}</p>
					{% endif %}
				</div>
			{% endif %}
		</div>
		</div>
	</section>

{% elseif hero_type == 'feature' and fields.hero_image %}

	{# ═══════════════════════════════════════════════════════════════
	   EDITORIAL HERO — full-viewport, full-bleed (default for features).
	   Type anchored bottom-left over a darkened image.
	   ═══════════════════════════════════════════════════════════════ #}
	<div
		class="h-svh text-white bg-black bg-no-repeat bg-cover md:bg-fixed flex items-end relative {{ block_classes }}"
		data-block-type="hero"
		style="z-index:0;background-image:url({{ fields.hero_image.url }});background-position:{{ focal_point }};"
		{% if anchor %}id="{{ anchor }}"{% endif %}
	>
		<div class="absolute inset-0 bg-gradient-to-tr {{ fields.more_contrast ? 'from-black/90 via-black/55' : 'from-black/80 via-black/35' }} to-transparent"></div>

		<div class="relative z-10 w-full pb-14 lg:pb-24">
			<div class="container mx-auto px-8 lg:px-0">
			<div class="max-w-3xl">
				{% if kicker %}
					<div data-animate="true" class="flex items-center gap-4 mb-6">
						<span class="h-px w-10 bg-green-bright"></span>
						<span class="font-science text-sm lg:text-base font-bold uppercase tracking-[0.3em] text-green-bright">{{ kicker }}</span>
					</div>
				{% endif %}

				{% if not fields.hide_post_title %}
					<h1 data-animate="true" class="delay-100! font-serif font-semibold leading-[1.02] text-white text-5xl lg:text-[5.5rem] text-shadow-lg">
						{{ post.title }}
					</h1>
				{% endif %}

				{% if fields.subheading %}
					<div data-animate="true" class="delay-200! mt-6 max-w-2xl font-sans text-lg lg:text-3xl leading-snug text-white/85 text-shadow-md">
						{{ fields.subheading }}
					</div>
				{% endif %}

				{% if story_author %}
					<p data-animate="true" class="delay-300! mt-8 font-science text-sm lg:text-base font-bold uppercase tracking-[0.2em] text-white/80">
						By {{ story_author }}
					</p>
				{% endif %}
			</div>
			</div>
		</div>

		{% if fields.photo_credit %}
			<div data-animate="true" class="delay-300! absolute bottom-5 right-5 lg:bottom-6 lg:right-8 font-science text-xs lg:text-sm text-white/75 text-shadow">
				Photo by {{ fields.photo_credit }}
			</div>
		{% endif %}
	</div>

{% elseif hero_type == 'edition' %}

	{# ═══════════════════════════════════════════════════════════════
	   EDITION HERO — cover treatment for an issue/edition homepage.
	   Full-width, deliberately shorter than the feature hero. The hero
	   image is the star — no green wash. Shared editorial language:
	   wordmark eyebrow → two-tone serif title (last word accented green)
	   → hairline rule → subheading → scroll-to-enter cue.
	   Edition eyebrow falls back to a wordmark when no preheading set.
	   ═══════════════════════════════════════════════════════════════ #}
	{% set edition_eyebrow = fields.preheading ?: 'Marshall Magazine' %}
	{% set _words = post.title|split(' ') %}
	{% set _accent = _words|length > 1 ? _words|last : '' %}
	{% set _head = _words|length > 1 ? _words|slice(0, _words|length - 1)|join(' ') : post.title %}

	{# ── Cinematic — type anchored low over the full-bleed photo, photo breathes up top. ── #}
	<section
		class="relative w-full min-h-[640px] lg:min-h-0 lg:h-[68vh] bg-black flex items-end justify-center text-center text-white {{ block_classes }}"
		data-block-type="hero"
		{% if anchor %}id="{{ anchor }}"{% endif %}
	>
		{% if fields.hero_image %}
			<div class="absolute inset-0 bg-cover bg-no-repeat md:bg-fixed" style="background-image:url({{ fields.hero_image.url }});background-position:{{ focal_point }};"></div>
		{% endif %}
		{# Bottom-up gradient so the upper photo stays clean and the type sits in shadow. #}
		<div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/45 to-transparent"></div>

		<div class="relative z-10 px-6 pb-28 lg:pb-24 max-w-3xl">
			<p data-animate="true" class="font-science text-sm font-bold uppercase tracking-[0.4em] text-green-bright">{{ edition_eyebrow }}</p>
			<h1 data-animate="true" class="delay-100! mt-5 lg:mt-6 font-serif font-semibold leading-[0.95] text-white text-5xl lg:text-8xl text-shadow-lg">
				{{ _head }}{% if _accent %}<span class="block text-green-bright">{{ _accent }}</span>{% endif %}
			</h1>
			<span data-animate="true" class="delay-200! mx-auto mt-6 lg:mt-7 block h-px w-24 bg-white/50"></span>
			{% if fields.subheading %}
				<p data-animate="true" class="delay-200! mx-auto mt-6 lg:mt-7 max-w-xl font-sans text-lg lg:text-2xl leading-snug text-white/85 text-shadow-md">{{ fields.subheading }}</p>
			{% endif %}
		</div>

		<a href="#content" data-animate="true" class="delay-300! group absolute bottom-6 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-1.5 text-white/80 hover:text-white">
			<span class="font-science text-xs font-bold uppercase tracking-[0.35em] text-shadow">Scroll to enter</span>
			<svg class="size-5 animate-bounce" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m19 9-7 7-7-7"/></svg>
		</a>

		{% if fields.photo_credit %}
			<div data-animate="true" class="delay-300! absolute bottom-5 right-5 lg:bottom-6 lg:right-8 z-10 font-science text-xs lg:text-sm text-white/75 text-shadow">
				Photo by {{ fields.photo_credit }}
			</div>
		{% endif %}
	</section>

{% endif %}

{# Anchor target for the hero "scroll to enter" arrow and the skip-link.
   Sits just below the hero so it lands at the top of the article body,
   offset for the fixed masthead. #}
<div id="content" tabindex="-1" class="scroll-mt-20"></div>
