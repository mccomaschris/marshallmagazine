{#
/**
 * Hero Block
 *
 * @package herdline
 */
#}
{% if fields.hero_image %}
	{% set focal_point = fields.hero_image.id|focal_point %}
	{% set story_type = post.meta('story_type') %}
	{% set story_author = post.meta('author') %}

	<div
		class="h-screen text-white bg-black bg-no-repeat bg-cover md:bg-fixed flex items-end relative {{ block_classes }}"
		data-block-type="hero"
		style="
			z-index: 0;
			background-image: url({{ fields.hero_image.url }});
			background-position: {{ focal_point }};
		"
		{% if anchor %}id="{{ anchor }}"{% endif %}
	>
		<div class="bg-gradient-to-t from-gray-900/50 via-gray-900/10 to-transparent h-full w-full absolute top-0 left-0 opacity-90"></div>

		{% if fields.photo_credit %}
			<div data-animate="true" class="delay-200! absolute top-[90px] right-0 lg:right-6 pr-4 lg:pr-8 pt-4 font-science font-bold text-lg text-white text-shadow">
				Photo by {{ fields.photo_credit }}
			</div>
		{% endif %}

		<div class="mb-12 lg:mb-24 max-w-4xl mx-auto px-6 lg:px-0 relative z-10">
			<div>
				{% if story_type in ['student', 'staff', 'faculty', 'alum'] %}
					<div data-animate="true" class="mb-4 font-science text-[2.75rem] lg:text-[3.5rem] text-white leading-none uppercase text-center text-shadow-md">
						<span class="font-black block text-shadow-lg">
							{% if story_type == 'student' %}Student{% endif %}
							{% if story_type == 'staff' %}Staff{% endif %}
							{% if story_type == 'faculty' %}Faculty{% endif %}
							{% if story_type == 'alum' %}Alum{% endif %}
						</span>
						<span class="font-normal block text-shadow-lg">
							{% if story_type == 'faculty' %}Feature{% else %}Spotlight{% endif %}
						</span>
					</div>

					<div data-animate="true" class="border-green border-dotted border-b-4 max-w-1/3 mx-auto my-8">
					</div>

					{% if fields.preheading %}
						<div data-animate="true" class="font-science text-2xl text-white leading-none text-center text-shadow-sm">
							{{ fields.preheading }}
						</div>
					{% endif %}

					{% if not fields.hide_post_title %}
						<h1 data-animate="true" class="font-bold font-science text-[3rem] lg:text-[4rem] text-center leading-[1.2] text-white text-shadow-md">
							{{ post.title }}
						</h1>
					{% endif %}

					{% if fields.subheading %}
						<span data-animate="true" class="font-normal block text-center text-shadow-lg text-[1.5rem] lg:text-4xl mt-6">{{ fields.subheading }}</span>
					{% endif %}

					{% if story_author %}
						<div data-animate="true" class="mt-8 text-center">
							<span class="px-6 py-4 leading-none bg-gray-900/70 text-white text-xl lg:text-2xl font-bold">By {{ story_author }}</span>
						</div>
					{% endif %}
				{% else %}
					<div data-animate="true" class="mb-4 font-science text-white leading-none uppercase text-center">
						{% if not fields.hide_post_title %}
							<h1 class="font-black block text-shadow-lg text-[3rem] lg:text-[4rem]">{{ post.title }}</h1>
						{% endif %}

						{% if fields.subheading %}
							<span class="font-normal block text-shadow-lg text-[1.5rem] lg:text-4xl mt-6">{{ fields.subheading }}</span>
						{% endif %}

						{% if story_author %}
							<div data-animate="true" class="mt-8 text-center">
								<span class="px-6 py-2 leading-none bg-gray-900/70 text-white text-lg lg:text-2xl font-bold">By {{ story_author }}</span>
							</div>
						{% endif %}
					</div>
				{% endif %}
			</div>
		</div>
	</div>
{% endif %}
