{#
/**
 * Q&A Block
 *
 * Flexible content — layouts: question_answer, pull_quote.
 *
 * @package herdline
 */
#}
<div
	data-block-type="qa"
	class="py-12 lg:py-24 bg-white {{ block_classes }}"
	{% if anchor %}id="{{ anchor }}"{% endif %}
>
	{% if fields.rows %}
		<div class="container mx-auto px-8 lg:px-0">
			<div class="animate-group">
				{% for row in fields.rows %}
					{% set prev_layout = loop.first ? '' : fields.rows[loop.index0 - 1].acf_fc_layout %}
					{# Suppress hairline when adjacent to a pull quote or inset image — visual weight carries the separation #}
					{% set border = (loop.first or prev_layout == 'pull_quote' or prev_layout == 'inset_image') ? '' : 'border-t border-gray-900/10' %}

					{% if row.acf_fc_layout == 'question_answer' %}

						<div data-animate="true" class="py-10 lg:py-16 {{ border }}">
							{% if row.question %}
								<div class="mb-5 max-w-[68ch] font-sans text-sm/relaxed font-semibold tracking-[0.2em] uppercase text-gray-400">{{ row.question }}</div>
							{% endif %}
							{% if row.answer %}
								<div class="qa-answer max-w-[60ch] font-sans text-xl/relaxed text-gray-800 [&_p]:mb-5 [&_p:last-child]:mb-0 [&_a]:text-green [&_a]:underline">
									{{ row.answer }}
								</div>
							{% endif %}
						</div>

					{% elseif row.acf_fc_layout == 'pull_quote' %}
						{% if row.quote %}
							<div data-animate="true" class="py-4 lg:py-6">
								<div class="-mx-8 lg:-mx-12">
									<blockquote class="bg-green/5 border-l-[3px] border-green px-8 lg:px-12 py-10 lg:py-14">
										<div class="font-serif text-2xl lg:text-3xl/snug text-gray-900 italic text-balance max-w-[68ch]">{{ row.quote }}</div>
										{% if row.attribution %}
											<cite class="mt-5 block font-sans text-xs font-semibold not-italic tracking-[0.2em] uppercase text-green">{{ row.attribution }}</cite>
										{% endif %}
									</blockquote>
								</div>
							</div>
						{% endif %}
					{% elseif row.acf_fc_layout == 'inset_image' %}
						<div class="max-w-[60ch]">
							{% include 'partials/inset-image.twig' with { 'image': row.image } %}
						</div>
					{% endif %}

				{% endfor %}
			</div>
		</div>
	{% endif %}
</div>
