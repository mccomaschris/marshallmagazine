{#
/**
 * Q&A Block (two-column rail)
 *
 * Interview-style pairs: the question sits as a brand-green label in a left
 * column, the answer flows in mundial in the wider right column (desktop);
 * stacks on mobile. Hairline rule between pairs.
 *
 * Expected context (built in callback.php, mirroring more-stories):
 *   fields.questions  array  [ { question: string, answer: string (html) } ]
 *   block_classes     string
 *   anchor            string
 *
 * @package herdline
 */
#}
<div
	data-block-type="qa"
	class="py-12 lg:py-24 bg-white {{ block_classes }}"
	{% if anchor %}id="{{ anchor }}"{% endif %}
>
	{% if fields.questions %}
		<div class="container mx-auto px-6 max-w-4xl">
			<div class="animate-group">
				{% for question in fields.questions %}
					<div
						data-animate="true"
						class="grid lg:grid-cols-[16rem_1fr] gap-x-10 gap-y-4 py-8 lg:py-12 border-t border-gray-900/10 first:border-t-0"
					>
						{% if question.question %}
							<h3 class="font-sans text-lg lg:text-xl font-bold text-green leading-snug text-balance lg:sticky lg:top-24 lg:self-start">
								{{ question.question }}
							</h3>
						{% endif %}

						{% if question.answer %}
							<div class="qa-answer font-sans text-xl/relaxed text-gray-700 [&_p]:mb-4 [&_p:last-child]:mb-0 [&_a]:text-green [&_a]:underline">
								{{ question.answer }}
							</div>
						{% endif %}
					</div>
				{% endfor %}
			</div>
		</div>
	{% endif %}
</div>
